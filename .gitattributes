# Normalise line endings for text; keep binaries untouched.
* text=auto
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.lua  text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.txt  text eol=crlf
*.png  binary
*.ogg  binary
*.docx binary
*.SDProfile          binary
*.streamDeckProfile  binary
